<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>BKID.AutoCrop</AssemblyName>
    <RootNamespace>BKID.AutoCrop</RootNamespace>
    <Version>3.0.0</Version>
    <AssemblyTitle>BKID AutoCrop</AssemblyTitle>
    <Description>Transparent viewport capture with an native BKID toolbar.</Description>
    <Company>BKID</Company>
    <Product>BKID AutoCrop</Product>
    <LangVersion>7.3</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="RhinoCommon" Version="6.0.18016.23451" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="../../BKID_AutoCrop/BKID_AutoCrop.py" LogicalName="BKID.AutoCrop.Capture.py" />
    <EmbeddedResource Include="../../BKID_AutoCrop/assets/icon_64.png" LogicalName="BKID.AutoCrop.Icon.png" />
    <EmbeddedResource Include="../../BKID_AutoCrop/assets/BKID_AutoCrop_Icon.svg" LogicalName="BKID.AutoCrop.Icon.svg" />
  </ItemGroup>
</Project>
